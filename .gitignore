# Keep reference directories while ignoring their contents.
/references/**
!/references/**/
!/references/**/.gitkeep

# MAME's default screenshot output must never become repository content.
/snap/

# MacOS
.DS_Store

# Github Issues
.github/issues/*

# Local Python environment and generated caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Pinned local tools and synthetic toolchain build artifacts
.tools/

# Native game imagery belongs with ignored contributor references, not Git.
/outputs/**/title*.png
/outputs/**/hardware-check.png
