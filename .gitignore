# Keep the reference tree through empty .gitkeep markers only. All payloads stay local.
/references/**
!/references/**/
!/references/**/.gitkeep

# MAME's default screenshot output must never become repository content.
/snap/

# MacOS
.DS_Store

# Github Issues
.github/issues/*

# Local Python environment and generated caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Pinned local tools and synthetic toolchain build artifacts
.tools/

# Generated cartridges, reports, workbooks and private emulator state.
# Disposable intermediates stay local; maintained workbooks and curated results live in docs/.
/outputs/**
/dist/**

# Contributor-owned original pixels and converted ROM resources.
/assets/arcade/**
/assets/namco-title-56x8.png
